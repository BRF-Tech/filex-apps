# filex Apps - your store's settings: copy to .env (next to docker-compose.yml)
# and fill it in. docs/SELF-HOSTING.md walks through every line.
#
# This file holds names, never values: the secrets you add to .env stay on the
# store's host (.env and keys.env are git-ignored here; keep both mode 0600).
# The signing keys, FAPPS_DATA_KEY, FAPPS_SESSION_KEY and the Web Push key
# pair are NOT set here: `fapps-server keygen -out keys.env` writes them into
# keys.env once (docs/SELF-HOSTING.md "Make the store's keys"). Never make
# them again for a store that has data.

# --- the image and where it listens ---
# A release of ghcr.io/brf-tech/filex-apps, e.g. 0.1.0 (never "latest" in
# production: an update is a decision, docs/SELF-HOSTING.md "Updating").
FAPPS_VERSION=
# Host address the app's HTTP port is published on; your reverse proxy talks
# to it. Loopback keeps it off the network.
FAPPS_BIND=127.0.0.1:8080

# --- your store ---
# The origin people and filex servers reach the store at (https, no path).
# Every absolute address the store writes (the index's media, the OAuth
# callback, install links) is built from it, never from request headers.
FAPPS_PUBLIC_URL=https://apps.example.com
# The name the pages show (default: FAPPS_PUBLIC_URL's host).
FAPPS_STORE_NAME=
# Your logo: a local SVG or PNG file inside the container, e.g.
# /branding/logo.svg with the ./branding mount in docker-compose.yml.
FAPPS_STORE_LOGO=
# Who runs the store, shown in the footer: a name and an address.
FAPPS_OPERATOR_NAME=
FAPPS_OPERATOR_URL=
# How to reach you: a mailto: or an https address.
FAPPS_CONTACT=
# Your terms and privacy pages, if you have them (https).
FAPPS_TERMS_URL=
FAPPS_PRIVACY_URL=

# --- sign-in (a GitHub OAuth App, docs/SELF-HOSTING.md "GitHub OAuth App") ---
# Callback: <FAPPS_PUBLIC_URL>/auth/github/callback. The client id is not a
# secret; the client secret is.
FAPPS_GITHUB_CLIENT_ID=
FAPPS_GITHUB_CLIENT_SECRET=
# Optional (a secret): a fine-grained token, public repositories, read-only,
# for the pipeline's GitHub reads. Without it they share GitHub's anonymous
# limit (60 requests an hour per address).
FAPPS_GITHUB_TOKEN=

# --- administrators and reviewers (docs/SELF-HOSTING.md "Choose the administrators") ---
# Numeric GitHub user ids, comma-separated: 12345 or login:12345 (the login
# is a label; a bare login is refused, since logins can be taken again).
FAPPS_ADMINS=
FAPPS_REVIEWERS=
# Or (also) from a private GitHub repository's collaborators: write or above
# makes an administrator, triage a reviewer. Needs FAPPS_ADMIN_TOKEN (a
# secret: fine-grained, that repository only, Metadata: read). No default.
FAPPS_ADMIN_REPO=
FAPPS_ADMIN_TOKEN=

# --- passwords of the stack itself (secrets) ---
# The database password: e.g. openssl rand -hex 24
FAPPS_DB_PASSWORD=
# The validators' throw-away administrator (they hold no data and take no
# traffic from outside): e.g. openssl rand -hex 16
FAPPS_VALIDATOR_PASSWORD=

# --- behind the reverse proxy ---
# Which peers may tell the store the visitor's address in X-Forwarded-For
# (CIDR list). Empty: only a loopback or private-address peer, and only the
# rightmost hop - right for a proxy on this host or the Docker network.
FAPPS_TRUSTED_PROXIES=
# An optional page counter's origin (https://host[:port]): the CSP then lets
# a counter script your proxy adds load and report. Empty: nothing else.
FAPPS_ANALYTICS_ORIGIN=

# --- the signed index ---
# Days an index is valid, and the days left at which it is re-signed.
FAPPS_INDEX_TTL_DAYS=60
FAPPS_INDEX_REFRESH_DAYS=30

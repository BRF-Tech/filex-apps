# The e2e stack's environment: the variables a hosting platform injects (a
# platform-style database and Redis, under the names such platforms use),
# plus the settings that point the store at the mocks. Loaded after
# .env.example, so a name here wins.
#
# NOTHING SECRET HERE. The database password, the session key, the GitHub
# client secret and the stand-in for FAPPS_ADMIN_TOKEN are made fresh for
# every run by scripts/e2e.sh and reach the app as
# environment (docker-compose.e2e.yml).

# --- what a hosting platform injects (the store reads APP_URL, APP_ENV,
# DATABASE_URL and REDIS_URL; the rest are there as a platform sets them) ---
APP_URL=https://fapps.e2e.test
# Development: the store's test-only fetch settings below are refused
# anywhere else.
APP_ENV=development
DEMO_NAME=fapps
DB_CONNECTION=pgsql
DB_HOST=demo-postgres
DB_PORT=5432
DB_DATABASE=demo_fapps
DB_USERNAME=demo_fapps
REDIS_HOST=demo-redis
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=
REDIS_URL=redis://demo-redis:6379/3

# --- the store pointed at the mocks ---
# Sign-ins at mock-idp (browsers and the store reach it by the same name).
# GitHub's API, raw files and release assets keep GitHub's own addresses:
# the app's sidecar (gh-app) answers them on 127.0.0.1:443 over HTTPS.
FAPPS_GITHUB_CLIENT_ID=e2e-github-client
FAPPS_GITHUB_OAUTH_URL=https://mock-idp:9443/github
FAPPS_GITHUB_API_URL=https://api.github.com
FAPPS_GITHUB_RAW_URL=https://raw.githubusercontent.com
# The administration repository of the mock (e2e/fixtures/repos.json:
# private, its collaborators e2e-admin write, e2e-reviewer triage,
# e2e-nobody read; only the run's FAPPS_ADMIN_TOKEN sees it). Set here on
# purpose: the store has no default, and the lists (FAPPS_ADMINS,
# FAPPS_REVIEWERS) stay empty so the roles come from this repository alone.
FAPPS_ADMIN_REPO=e2e-org/store-admins
FAPPS_ADMINS=
FAPPS_REVIEWERS=

# The store's own name, logo and operator (the pages and the footer show
# them; the logo is e2e/fixtures/brand/logo.svg, mounted by
# docker-compose.e2e.yml).
FAPPS_STORE_NAME=Example Apps
FAPPS_STORE_LOGO=/brand/logo.svg
FAPPS_OPERATOR_NAME=Example Org
FAPPS_OPERATOR_URL=https://www.example.com/
FAPPS_CONTACT=mailto:store@example.com
FAPPS_TERMS_URL=https://www.example.com/terms
FAPPS_PRIVACY_URL=https://www.example.com/privacy

# Test-only outbound settings (development only): private and loopback
# addresses allowed, the run's CA trusted, the mock host on the allow list.
# HTTPS stays required.
FAPPS_FETCH_ALLOW_PRIVATE=1
FAPPS_FETCH_CA_FILE=/e2e-ca/ca.pem
FAPPS_FETCH_ALLOW_HOSTS=github.com,api.github.com,raw.githubusercontent.com,objects.githubusercontent.com,release-assets.githubusercontent.com,github-releases.githubusercontent.com,codeload.github.com,mock-idp:9443

# The edge (the reverse proxy's stand-in) reaches the app from a private
# address on the compose network, so the default (empty) applies.
FAPPS_TRUSTED_PROXIES=

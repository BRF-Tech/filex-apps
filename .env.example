# filex app store - environment template: the non-secret settings of the
# e2e stack and local development. A production store keeps its own copy
# with its own values and its secrets beside it (never in a repository).
#
# APP_URL, APP_ENV, DATABASE_URL, REDIS_URL and friends come after this file
# (the e2e stack: e2e/stack.env) and win over it. NOTHING SECRET GOES HERE:
# this file is in the repository. The secrets (FAPPS_SESSION_KEY,
# FAPPS_GITHUB_CLIENT_ID / _SECRET, FAPPS_GITHUB_TOKEN, FAPPS_ADMIN_TOKEN,
# FAPPS_DATA_KEY, FAPPS_VAPID_PRIVATE_KEY, and without FAPPS_DEMO_KEYS the
# signing keys) reach the server through the environment only.
# `fapps-server keygen -out <file>` makes every key and secret a new store
# needs into one new file (mode 0600) and prints only the public halves.
#
# FAPPS_FETCH_ALLOW_PRIVATE and FAPPS_FETCH_CA_FILE exist for development and
# the e2e stack only (e2e/stack.env); they never belong here.

FAPPS_LISTEN=0.0.0.0:8080

# Everyone signs in with GitHub (an OAuth App; its client id and secret come
# with the secrets). These three are GitHub's own addresses (sign-in, REST API,
# files at a commit); the e2e stack points only the sign-in at its mock and
# answers the other two on GitHub's own names (e2e/stack.env).
FAPPS_GITHUB_OAUTH_URL=https://github.com
FAPPS_GITHUB_API_URL=https://api.github.com
FAPPS_GITHUB_RAW_URL=https://raw.githubusercontent.com

# Which peers may tell the store the client's address in X-Forwarded-For
# (CIDR list). Empty: only a loopback or private-address peer, and only the
# rightmost hop. Behind Caddy in production and behind the e2e stack's edge
# the peer is a private address, so empty is the setting; docs/DEPLOY.md
# "Client addresses" says what the store then sees.
FAPPS_TRUSTED_PROXIES=

# An optional page counter's origin (https://host[:port], nothing else), e.g.
# https://stats.example.com: the CSP then lets the counter's script
# load from it and report to it. The store prints no counter script; the
# reverse proxy in front adds it. Empty: the CSP allows no other origin.
FAPPS_ANALYTICS_ORIGIN=

# How the store names and presents itself. FAPPS_STORE_NAME is the brand,
# the tab title, the web app's name and the notifications' sender (default:
# the host of FAPPS_PUBLIC_URL / APP_URL, so no store passes for another).
# FAPPS_STORE_LOGO is a local SVG or PNG file (at most 256 KiB), served from
# the store's own origin; empty: filex's mark. The rest is the footer's
# "Operated by ... / Contact / Terms of service / Privacy policy" line, each
# shown only when set: a name, https addresses, and a mailto: or https
# contact (also the push services' contact when FAPPS_VAPID_SUBJECT is empty).
FAPPS_STORE_NAME=
FAPPS_STORE_LOGO=
FAPPS_OPERATOR_NAME=
FAPPS_OPERATOR_URL=
FAPPS_CONTACT=
FAPPS_TERMS_URL=
FAPPS_PRIVACY_URL=

# Who reviews and administers the store; everyone signs in with GitHub.
# Either or both (a person then holds the higher role); outside
# APP_ENV=development the store does not start without FAPPS_ADMIN_REPO or
# FAPPS_ADMINS.
# - FAPPS_ADMIN_REPO (owner/name, no default): the permission on this
#   private repository, read at every sign-in with FAPPS_ADMIN_TOKEN (a
#   secret): admin, maintain or write make an administrator, triage a
#   reviewer.
# - FAPPS_ADMINS, FAPPS_REVIEWERS: comma lists of GitHub accounts by their
#   NUMERIC user id, `12345` or `alice:12345` (the login is a label only; a
#   bare login is refused, since a login can be given up and registered
#   again by someone else). https://api.github.com/users/<login> gives the id.
FAPPS_ADMIN_REPO=
FAPPS_ADMINS=
FAPPS_REVIEWERS=

# The e2e stack and local development sign with throw-away keys the store
# generates itself; no real filex trusts them. Refused unless APP_ENV is demo
# or development; never in production.
FAPPS_DEMO_KEYS=1
FAPPS_INDEX_TTL_DAYS=60
FAPPS_INDEX_REFRESH_DAYS=30

# Browser notifications (Web Push): FAPPS_VAPID_PUBLIC_KEY and FAPPS_VAPID_PRIVATE_KEY (a secret)
# come with the secrets, set together or not at all; without them the browser notifications are off
# and the webhooks work. FAPPS_VAPID_SUBJECT defaults to FAPPS_PUBLIC_URL when it is https.

# The validators (docker-compose.yml). Their password guards instances that
# hold no data and have no ingress; it is not a secret.
FAPPS_VALIDATORS=latest=http://filex-latest:5212,floor=http://filex-floor:5212
FAPPS_VALIDATOR_EMAIL=validator@local
FAPPS_VALIDATOR_PASSWORD=validator-local-only
